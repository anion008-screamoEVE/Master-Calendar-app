rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(uid());
    }

    function userExists() {
      return exists(userPath());
    }

    function userDoc() {
      return get(userPath()).data;
    }

    function isMaster() {
      return isSignedIn() && userExists() && userDoc().role == 'master';
    }

    function hasActiveSub() {
      return isMaster()
        && ('subscriptionStatus' in userDoc())
        && (userDoc().subscriptionStatus == 'trial' || userDoc().subscriptionStatus == 'active')
        && ('subscriptionExpiresAt' in userDoc())
        && userDoc().subscriptionExpiresAt is timestamp
        && userDoc().subscriptionExpiresAt > request.time;
    }

    function listEditors() {
      return ('editors' in resource.data) ? resource.data.editors : [];
    }

    function listViewers() {
      return ('viewers' in resource.data) ? resource.data.viewers : [];
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function authPhone() {
      return request.auth.token.phone_number;
    }

    function canReadCalResource() {
      return isSignedIn() && (
        resource.data.ownerId == uid()
        || uid() in listEditors()
        || uid() in listViewers()
      );
    }

    function canEditCalById(calId) {
      let c = get(/databases/$(database)/documents/calendars/$(calId)).data;
      let eds = ('editors' in c) ? c.editors : [];
      return isSignedIn() && (c.ownerId == uid() || uid() in eds);
    }

    function canReadCalById(calId) {
      let c = get(/databases/$(database)/documents/calendars/$(calId)).data;
      let eds = ('editors' in c) ? c.editors : [];
      let vws = ('viewers' in c) ? c.viewers : [];
      return isSignedIn() && (
        c.ownerId == uid() || uid() in eds || uid() in vws
      );
    }

    // Invitee may add ONLY their own uid to editors or viewers
    // if their email/phone is listed in pending* on the calendar
    function isSelfAcceptShare() {
      let oldEds = listEditors();
      let oldVws = listViewers();
      let newEds = ('editors' in request.resource.data) ? request.resource.data.editors : [];
      let newVws = ('viewers' in request.resource.data) ? request.resource.data.viewers : [];
      let pendingE = ('pendingEditors' in resource.data) ? resource.data.pendingEditors : [];
      let pendingV = ('pendingViewers' in resource.data) ? resource.data.pendingViewers : [];
      let emailOk = authEmail() != null && (
        authEmail() in pendingE || authEmail() in pendingV
        || (userExists() && userDoc().email != null && (
          userDoc().email in pendingE || userDoc().email in pendingV
        ))
      );
      let phoneOk = authPhone() != null && (
        authPhone() in pendingE || authPhone() in pendingV
        || (userExists() && userDoc().phone != null && (
          userDoc().phone in pendingE || userDoc().phone in pendingV
        ))
      );
      let addedSelfEditor = uid() in newEds && !(uid() in oldEds);
      let addedSelfViewer = uid() in newVws && !(uid() in oldVws);
      return isSignedIn()
        && request.resource.data.ownerId == resource.data.ownerId
        && (emailOk || phoneOk)
        && (addedSelfEditor || addedSelfViewer)
        && !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['ownerId', 'name', 'color', 'isPrimary', 'createdAt']);
    }

    match /users/{userId} {
      // Allow signed-in users to read profiles (needed to resolve share targets by email)
      allow read: if isSignedIn();

      allow create: if isSignedIn()
        && uid() == userId
        && request.resource.data.role in ['master', 'client'];

      allow update: if isSignedIn()
        && uid() == userId
        && request.resource.data.role == resource.data.role
        && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        && request.resource.data.subscriptionExpiresAt == resource.data.subscriptionExpiresAt;

      allow delete: if false;
    }

    match /calendars/{calId} {
      allow read: if canReadCalResource();

      allow create: if isMaster()
        && hasActiveSub()
        && request.resource.data.ownerId == uid();

      allow update: if isSignedIn() && (
        resource.data.ownerId == uid()
        || (
          uid() in listEditors()
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['ownerId', 'editors', 'viewers', 'pendingEditors', 'pendingViewers'])
        )
        || isSelfAcceptShare()
      );

      allow delete: if isSignedIn() && resource.data.ownerId == uid();
    }

    match /appointments/{aptId} {
      allow read: if isSignedIn() && canReadCalById(resource.data.calendarId);

      allow create: if isSignedIn()
        && canEditCalById(request.resource.data.calendarId);

      allow update, delete: if isSignedIn()
        && canEditCalById(resource.data.calendarId);
    }

    match /shares/{shareId} {
      // Recipient must be able to query invites by email / phone / uid
      allow read: if isSignedIn() && (
        resource.data.fromUid == uid()
        || resource.data.toUid == uid()
        || (authEmail() != null && resource.data.toEmail == authEmail())
        || (authPhone() != null && resource.data.toPhone == authPhone())
        || (
          userExists()
          && userDoc().email != null
          && resource.data.toEmail == userDoc().email
        )
        || (
          userExists()
          && userDoc().phone != null
          && resource.data.toPhone == userDoc().phone
        )
      );

      allow create: if isSignedIn() && request.resource.data.fromUid == uid();

      allow update: if isSignedIn() && (
        resource.data.fromUid == uid()
        || resource.data.toUid == uid()
        || (authEmail() != null && resource.data.toEmail == authEmail())
        || (authPhone() != null && resource.data.toPhone == authPhone())
        || (
          userExists()
          && userDoc().email != null
          && resource.data.toEmail == userDoc().email
        )
        || (
          userExists()
          && userDoc().phone != null
          && resource.data.toPhone == userDoc().phone
        )
      );

      allow delete: if isSignedIn() && resource.data.fromUid == uid();
    }

    match /fcmTokens/{tokenId} {
      allow read: if isSignedIn() && resource.data.uid == uid();
      allow create: if isSignedIn() && request.resource.data.uid == uid();
      allow update, delete: if isSignedIn() && resource.data.uid == uid();
    }

    match /payments/{id} {
      allow read: if isSignedIn() && resource.data.uid == uid();
      allow write: if false;
    }
  }
}
